HOST_NAME=http://localhost:5173

# One SQLite file, named twice, because the two tools that open it resolve a
# relative path from different places. The app resolves it from the project
# root, which is the cwd `gemi dev` runs in. Prisma resolves it from the
# directory its schema is in, which is `prisma/`. Give both `file:./dev.db` and
# they open two different files: the migrated one under `prisma/`, and an empty
# one at the root that the app creates on first query and then fails against
# with `no such table: User`.
DATABASE_URL=file:./prisma/dev.db
PRISMA_DATABASE_URL=file:./dev.db

# openssl rand -base64 32 | head -c 32
#
# Not optional for this template: SECRET is the key an approval signature is
# minted with. Leave it at the placeholder and anyone can forge an approval for
# a tool you gated behind one.
SECRET=SECRET

### The model provider. One of these two sets.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_RESOURCE_NAME=
# AZURE_OPENAI_ENDPOINT=

### Email
EMAIL_DEBUG=true
# RESEND_API_KEY=
